# Copy values into your local secret files. Do not commit real secrets.

# Windows-side fallback used by AutoSetupHermes/a.sh
# Default local path: C:\Users\<you>\.codex\secrets\hermes-telegram.env
TELEGRAM_BOT_TOKEN=1234567890:replace_with_your_bot_token
TELEGRAM_ALLOWED_USERS=123456789
TELEGRAM_TEST_CHAT_ID=123456789

# Optional overrides used by AutoSetupHermes/resume.sh
HERMES_WSL_USER=ubuntu
HERMES_TMUX_SESSION=hermes-gateway
