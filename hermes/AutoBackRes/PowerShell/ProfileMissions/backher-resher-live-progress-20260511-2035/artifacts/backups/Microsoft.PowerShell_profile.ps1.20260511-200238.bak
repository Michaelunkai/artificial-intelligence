function global:Resolve-WingetExecutable {
    if ($script:CachedWingetExecutable -and (Test-Path -LiteralPath $script:CachedWingetExecutable -PathType Leaf)) {
        return $script:CachedWingetExecutable
    }

    $windowsApps = Join-Path $env:LOCALAPPDATA 'Microsoft\WindowsApps'
    if ((Test-Path -LiteralPath $windowsApps -PathType Container) -and (($env:Path -split ';') -notcontains $windowsApps)) {
        $env:Path = "$env:Path;$windowsApps"
    }

    $userPath = [Environment]::GetEnvironmentVariable('Path', 'User')
    if ($windowsApps -and (Test-Path -LiteralPath $windowsApps -PathType Container) -and (($userPath -split ';') -notcontains $windowsApps)) {
        $newUserPath = if ([string]::IsNullOrWhiteSpace($userPath)) { $windowsApps } else { "$userPath;$windowsApps" }
        [Environment]::SetEnvironmentVariable('Path', $newUserPath, 'User')
    }

    $command = Get-Command winget.exe -CommandType Application -ErrorAction SilentlyContinue | Select-Object -First 1
    if ($command) {
        $script:CachedWingetExecutable = $command.Source
        return $script:CachedWingetExecutable
    }

    $aliasPath = Join-Path $windowsApps 'winget.exe'
    if (Test-Path -LiteralPath $aliasPath -PathType Leaf) {
        $script:CachedWingetExecutable = $aliasPath
        return $script:CachedWingetExecutable
    }

    $packagedWinget = Get-ChildItem -Path 'C:\Program Files\WindowsApps' -Filter winget.exe -Recurse -ErrorAction SilentlyContinue |
        Where-Object { $_.FullName -like '*Microsoft.DesktopAppInstaller_*' } |
        Sort-Object LastWriteTime -Descending |
        Select-Object -First 1
    if ($packagedWinget) {
        $script:CachedWingetExecutable = $packagedWinget.FullName
        return $script:CachedWingetExecutable
    }

    throw 'winget is not available. Microsoft.DesktopAppInstaller is missing or its WindowsApps alias is disabled.'
}

function global:winget {
    $wingetExe = Resolve-WingetExecutable
    & $wingetExe @args
}

function global:Get-InstalledStateToolPython {
    $portablePython = 'F:\backup\windowsapps\AppsBackups\Macrium\python312\python.exe'
    if (Test-Path -LiteralPath $portablePython) {
        & $portablePython -m pip --version *> $null
        if ($LASTEXITCODE -ne 0) {
            & $portablePython -m ensurepip --upgrade | Out-Host
        }
        return $portablePython
    }

    $python = Get-Command python -ErrorAction SilentlyContinue
    if ($python) {
        python -m pip --version *> $null
        if ($LASTEXITCODE -ne 0) {
            python -m ensurepip --upgrade | Out-Host
        }
        return 'python'
    }

    throw 'No Python runtime found for installed-state backup/restore.'
}

function global:Get-InstalledStateToolScript {
    $primary = 'F:\study\Devops\backup\WindowsInstalled\state\backup_restore\tooling\installed_state_backup_restore.py'
    $backup = 'F:\backup\windowsapps\AppsBackups\installed\tooling\installed_state_backup_restore.py'
    if (Test-Path -LiteralPath $primary) {
        $backupDir = Split-Path -Parent $backup
        if (-not (Test-Path -LiteralPath $backupDir)) {
            New-Item -ItemType Directory -Path $backupDir -Force | Out-Null
        }
        Copy-Item -LiteralPath $primary -Destination $backup -Force -ErrorAction SilentlyContinue
        return $primary
    }
    if (Test-Path -LiteralPath $backup) {
        return $backup
    }
    throw "Installed-state restore script not found. Checked: $primary and $backup"
}

