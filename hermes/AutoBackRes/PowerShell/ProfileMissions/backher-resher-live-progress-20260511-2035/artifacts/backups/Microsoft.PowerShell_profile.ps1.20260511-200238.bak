function global:Ensure-ProfileGetFileHashCommand {
    if (Get-Command Get-FileHash -ErrorAction SilentlyContinue) { return }
    Import-Module Microsoft.PowerShell.Utility -ErrorAction SilentlyContinue
    if (Get-Command Get-FileHash -ErrorAction SilentlyContinue) { return }

    function global:Get-FileHash {
        [CmdletBinding(DefaultParameterSetName = 'Path')]
        param(
            [Parameter(Mandatory = $true, Position = 0, ParameterSetName = 'Path')]
            [string[]]$Path,

            [Parameter(Mandatory = $true, ParameterSetName = 'LiteralPath')]
            [Alias('PSPath')]
            [string[]]$LiteralPath,

            [ValidateSet('SHA1', 'SHA256', 'SHA384', 'SHA512', 'MD5')]
            [string]$Algorithm = 'SHA256'
        )

        $inputPaths = if ($PSCmdlet.ParameterSetName -eq 'LiteralPath') { $LiteralPath } else { $Path }
        foreach ($inputPath in $inputPaths) {
            $resolvedPaths = if ($PSCmdlet.ParameterSetName -eq 'LiteralPath') {
                Resolve-Path -LiteralPath $inputPath -ErrorAction Stop
            } else {
                Resolve-Path -Path $inputPath -ErrorAction Stop
            }

            foreach ($resolvedPath in $resolvedPaths) {
                $stream = [System.IO.File]::OpenRead($resolvedPath.ProviderPath)
                $hashAlgorithm = [System.Security.Cryptography.HashAlgorithm]::Create($Algorithm)
                try {
                    $hashBytes = $hashAlgorithm.ComputeHash($stream)
                    $hash = ([System.BitConverter]::ToString($hashBytes) -replace '-', '').ToUpperInvariant()
                    [pscustomobject]@{
                        Algorithm = $Algorithm.ToUpperInvariant()
                        Hash = $hash
                        Path = $resolvedPath.ProviderPath
                    }
                } finally {
                    if ($hashAlgorithm) { $hashAlgorithm.Dispose() }
                    $stream.Dispose()
                }
            }
        }
    }
}
function global:Resolve-ProfilePythonExecutable {
    if ($script:CachedProfilePythonExecutable -and (Test-Path -LiteralPath $script:CachedProfilePythonExecutable -PathType Leaf)) {
        return $script:CachedProfilePythonExecutable
    }

    $candidatePaths = @(
        $env:CODEX_PROFILE_PYTHON,
        (Join-Path $env:LOCALAPPDATA 'Programs\Python\Python312\python.exe'),
        (Join-Path $env:LOCALAPPDATA 'Programs\Python\Python311\python.exe'),
        'C:\Python312\python.exe',
        'C:\Python311\python.exe'
    )

    foreach ($candidate in $candidatePaths) {
        if ([string]::IsNullOrWhiteSpace($candidate)) { continue }
        if (Test-Path -LiteralPath $candidate -PathType Leaf) {
            $script:CachedProfilePythonExecutable = (Resolve-Path -LiteralPath $candidate).ProviderPath
            return $script:CachedProfilePythonExecutable
        }
    }

    $command = Get-Command python -All -CommandType Application -ErrorAction SilentlyContinue |
        Where-Object { $_.Path -and $_.Path -notlike '*\Microsoft\WindowsApps\python*.exe' } |
        Select-Object -First 1
    if ($command) {
        $script:CachedProfilePythonExecutable = $command.Path
        return $script:CachedProfilePythonExecutable
    }

    $launcher = Get-Command py.exe -CommandType Application -ErrorAction SilentlyContinue
    if ($launcher) { return $launcher.Path }

    throw 'No usable Python interpreter found. Install Python or set CODEX_PROFILE_PYTHON to a real python.exe path.'
}

function global:python {
    $resolvedPython = Resolve-ProfilePythonExecutable
    if ([System.IO.Path]::GetFileName($resolvedPython) -ieq 'py.exe') {
        & $resolvedPython -3 @args
        return
    }
    & $resolvedPython @args
}

function Optimize-CurrentTerminalResponsiveness {
    try {
        $current = [System.Diagnostics.Process]::GetCurrentProcess()
        if ($current.PriorityClass -in @('Idle', 'BelowNormal', 'Normal')) {
            $current.PriorityClass = 'AboveNormal'
        }

        $processId = $PID
        for ($depth = 0; $depth -lt 6; $depth++) {
            $procInfo = Get-CimInstance Win32_Process -Filter "ProcessId=$processId" -ErrorAction SilentlyContinue
            if (-not $procInfo -or -not $procInfo.ParentProcessId) { break }
            $processId = [int]$procInfo.ParentProcessId
            $parent = Get-Process -Id $processId -ErrorAction SilentlyContinue
            if (-not $parent) { continue }
            if ($parent.ProcessName -eq 'WindowsTerminal') {
                if ($parent.PriorityClass -ne 'High') { $parent.PriorityClass = 'High' }
            } elseif ($parent.ProcessName -in @('OpenConsole', 'conhost', 'cmd', 'powershell', 'pwsh')) {
                if ($parent.PriorityClass -in @('Idle', 'BelowNormal', 'Normal')) { $parent.PriorityClass = 'AboveNormal' }
            }
        }
    } catch { }
}

if ($script:ProfileIsInteractiveConsole) {
    try {
        $current = [System.Diagnostics.Process]::GetCurrentProcess()
        if ($current.PriorityClass -in @('Idle', 'BelowNormal', 'Normal')) {
            $current.PriorityClass = 'AboveNormal'
        }
    } catch { }
}

function Repair-StandardWindowsProcessEnvironment {
    $systemRoot = [Environment]::GetEnvironmentVariable('SystemRoot', 'Process')
    if ([string]::IsNullOrWhiteSpace($systemRoot)) {
        $systemRoot = [Environment]::GetEnvironmentVariable('SystemRoot', 'Machine')
    }
    if ([string]::IsNullOrWhiteSpace($systemRoot)) { $systemRoot = 'C:\Windows' }

    $systemDrive = [Environment]::GetEnvironmentVariable('SystemDrive', 'Process')
    if ([string]::IsNullOrWhiteSpace($systemDrive) -and $systemRoot -match '^[A-Za-z]:') {
        $systemDrive = $systemRoot.Substring(0, 2)
    }
    if ([string]::IsNullOrWhiteSpace($systemDrive)) { $systemDrive = 'C:' }

    $defaults = @{
        SystemDrive = $systemDrive
        SystemRoot = $systemRoot
        windir = $systemRoot
        ProgramData = (Join-Path $systemDrive 'ProgramData')
        ALLUSERSPROFILE = (Join-Path $systemDrive 'ProgramData')
        PUBLIC = (Join-Path $systemDrive 'Users\Public')
    }

    foreach ($name in $defaults.Keys) {
        if ([string]::IsNullOrWhiteSpace([Environment]::GetEnvironmentVariable($name, 'Process'))) {
            Set-Item -Path "Env:$name" -Value $defaults[$name]
        }
    }
}
Repair-StandardWindowsProcessEnvironment

function Initialize-FastProfilePsReadLineHistory {
    try {
        $root = Join-Path $env:APPDATA 'Microsoft\Windows\PowerShell\PSReadLine'
        $sessionDir = Join-Path $root 'sessions'
        if (-not (Test-Path -LiteralPath $sessionDir -PathType Container)) {
            New-Item -ItemType Directory -Path $sessionDir -Force | Out-Null
        }

        $sessionPath = Join-Path $sessionDir ("ConsoleHost_{0}.txt" -f $PID)
        if (-not (Test-Path -LiteralPath $sessionPath -PathType Leaf)) {
            New-Item -ItemType File -Path $sessionPath -Force | Out-Null
        }

        if (Get-Command Set-PSReadLineOption -ErrorAction SilentlyContinue) {
            Set-PSReadLineOption -HistorySavePath $sessionPath -HistorySaveStyle SaveIncrementally -ErrorAction SilentlyContinue
        }
    } catch { }
}

function Update-FullProfileDefinitionCache {
    param(
        [Parameter(Mandatory = $true)][string]$SourcePath,
        [Parameter(Mandatory = $true)][string]$CachePath
    )

    if (-not (Test-Path -LiteralPath $SourcePath -PathType Leaf)) {
        throw "Full PowerShell profile library not found: $SourcePath"
    }

    $sourceItem = Get-Item -LiteralPath $SourcePath
    $cacheFormat = '# FullProfileDefinitionCacheFormat: 2'
    if (Test-Path -LiteralPath $CachePath -PathType Leaf) {
        $cacheItem = Get-Item -LiteralPath $CachePath
        $cacheHeader = Get-Content -LiteralPath $CachePath -TotalCount 3 -ErrorAction SilentlyContinue
        if ($cacheItem.LastWriteTimeUtc -ge $sourceItem.LastWriteTimeUtc -and $cacheHeader -contains $cacheFormat) { return }
    }

    $parseErrors = $null
    $tokens = $null
    $ast = [System.Management.Automation.Language.Parser]::ParseFile($SourcePath, [ref]$tokens, [ref]$parseErrors)
    if ($parseErrors -and $parseErrors.Count -gt 0) {
        throw "Cannot parse full PowerShell profile library '$SourcePath': $($parseErrors[0].Message)"
    }

    $lastFunctionLines = New-Object 'System.Collections.Hashtable' ([System.StringComparer]::OrdinalIgnoreCase)
    foreach ($functionAst in $ast.FindAll({ param($node) $node -is [System.Management.Automation.Language.FunctionDefinitionAst] }, $true)) {
        $functionName = $functionAst.Name -replace '^(?i:global:)', ''
        $lastFunctionLines[$functionName] = $functionAst.Extent.StartLineNumber
    }

    $parts = New-Object 'System.Collections.Generic.List[string]'
    $parts.Add($cacheFormat) | Out-Null
    $parts.Add("# Generated from $SourcePath. Contains final function definitions and safe assignments only.") | Out-Null
    $parts.Add("# Regenerate by calling fullprofile after editing the full profile source.") | Out-Null

    foreach ($statement in $ast.EndBlock.Statements) {
        if ($statement -is [System.Management.Automation.Language.FunctionDefinitionAst]) {
            $functionName = $statement.Name -replace '^(?i:global:)', ''
            if ($lastFunctionLines[$functionName] -eq $statement.Extent.StartLineNumber) {
                $parts.Add($statement.Extent.Text.TrimEnd()) | Out-Null
            }
            continue
        }

        if ($statement -is [System.Management.Automation.Language.AssignmentStatementAst]) {
            $commands = @($statement.FindAll({ param($node) $node -is [System.Management.Automation.Language.CommandAst] }, $true))
            if ($commands.Count -eq 0) {
                $parts.Add($statement.Extent.Text.TrimEnd()) | Out-Null
            }
            continue
        }

        if ($statement -is [System.Management.Automation.Language.PipelineAst]) {
            $commands = @($statement.FindAll({ param($node) $node -is [System.Management.Automation.Language.CommandAst] }, $true))
            if ($commands.Count -gt 0 -and @($commands | Where-Object { $_.GetCommandName() -ne 'Set-Alias' }).Count -eq 0) {
                $parts.Add($statement.Extent.Text.TrimEnd()) | Out-Null
            }
        }
    }

    $cacheDir = Split-Path -Parent $CachePath
    if (-not (Test-Path -LiteralPath $cacheDir -PathType Container)) {
        New-Item -ItemType Directory -Path $cacheDir -Force | Out-Null
    }

    $tempPath = "$CachePath.tmp"
    [System.IO.File]::WriteAllText($tempPath, ($parts -join [Environment]::NewLine + [Environment]::NewLine), [System.Text.UTF8Encoding]::new($false))
    Move-Item -LiteralPath $tempPath -Destination $CachePath -Force
}

$script:ProfileMyFixOverride = {
    [CmdletBinding()]
    param([switch]$NoReboot)

    $isoPath = 'E:\isos\Michrepair.iso'
    if (-not (Test-Path -LiteralPath $isoPath -PathType Leaf)) {
        throw "Michrepair ISO not found at $isoPath"
    }

    $ventoyDrive = 'E:'
    $ventoyJson = Join-Path $ventoyDrive 'ventoy\ventoy.json'
    $ventoyImagePath = '/isos/Michrepair.iso'
    $cfg = [ordered]@{
        control = @(
            [ordered]@{ VTOY_DEFAULT_MENU_MODE = '0' }
            [ordered]@{ VTOY_DEFAULT_SEARCH_ROOT = '/isos' }
            [ordered]@{ VTOY_MENU_TIMEOUT = '3' }
            [ordered]@{ VTOY_DEFAULT_IMAGE = $ventoyImagePath }
            [ordered]@{ VTOY_SECONDARY_BOOT_MENU = '1' }
            [ordered]@{ VTOY_SECONDARY_TIMEOUT = '3' }
        )
    } | ConvertTo-Json -Depth 5 -Compress

    $ventoyDir = Split-Path -Parent $ventoyJson
    if (-not (Test-Path -LiteralPath $ventoyDir -PathType Container)) {
        New-Item -ItemType Directory -Path $ventoyDir | Out-Null
    }
    [System.IO.File]::WriteAllText($ventoyJson, $cfg, [System.Text.Encoding]::ASCII)

    $volumes = Get-CimInstance Win32_Volume
    $ventoyVolume = $volumes | Where-Object { $_.DriveLetter -eq $ventoyDrive } | Select-Object -First 1
    if (-not $ventoyVolume) {
        throw "Could not map $ventoyDrive to a Windows volume."
    }

    $volumeId = ($ventoyVolume.DeviceID -replace '^\\\\\?\\Volume\{', '') -replace '\}\\$', ''
    $diskSignature = ($volumeId -split '-')[0]
    $efiVolume = $volumes |
        Where-Object { -not $_.DriveLetter -and $_.DeviceID -like "\\?\Volume{$diskSignature-*" -and $_.DeviceID -notlike '*-0000-0000-0000-*' } |
        Select-Object -First 1
    if (-not $efiVolume) {
        throw "Could not find hidden Ventoy EFI partition paired with $ventoyDrive."
    }

    $logicalLink = Get-CimInstance Win32_LogicalDiskToPartition |
        Where-Object { $_.Dependent -match 'DeviceID = "E:"' } |
        Select-Object -First 1
    if (-not $logicalLink -or $logicalLink.Antecedent -notmatch 'Disk #(\d+), Partition #(\d+)') {
        throw "Could not map $ventoyDrive to its disk partition."
    }
    $diskNumber = [int]$Matches[1]
    $dataPartitionNumber = [int]$Matches[2] + 1

    try {
        $storagePartitions = Get-CimInstance -Namespace root\Microsoft\Windows\Storage -ClassName MSFT_Partition -ErrorAction Stop
        $dataPartition = $storagePartitions |
            Where-Object { $_.DiskNumber -eq $diskNumber -and $_.PartitionNumber -eq $dataPartitionNumber -and $_.DriveLetter -eq 'E' } |
            Select-Object -First 1
        $efiPartition = $storagePartitions |
            Where-Object {
                $_.DiskNumber -eq $diskNumber -and
                $_.PartitionNumber -gt $dataPartitionNumber -and
                $_.MbrType -eq 239 -and
                $_.AccessPaths -contains $efiVolume.DeviceID
            } |
            Sort-Object PartitionNumber |
            Select-Object -First 1
        if (-not $dataPartition -or -not $efiPartition) {
            throw "Could not verify the hidden Ventoy EFI partition belongs to $ventoyDrive."
        }
    } catch [Microsoft.Management.Infrastructure.CimException] {
        Write-Warning "Skipping MSFT_Partition verification because Windows Storage CIM returned: $($_.Exception.Message). Continuing with Win32 volume/link checks."
    }

    $fltmcText = fltmc volumes
    $dataLine = $fltmcText | Where-Object { $_ -match '^\s*E:\s+\\Device\\HarddiskVolume(\d+)\s+' } | Select-Object -First 1
    if (-not $dataLine -or $dataLine -notmatch '\\Device\\HarddiskVolume(\d+)') {
        throw "Could not resolve $ventoyDrive device path from fltmc."
    }
    $efiDevice = "\Device\HarddiskVolume$([int]$Matches[1] + 1)"

    $firmwareText = bcdedit /enum firmware
    $entry = [regex]::Matches(($firmwareText -join "`n"), '(?ms)^Firmware Application.*?(?=^Firmware Application|^Windows Boot Manager|^Firmware Boot Manager|\z)') |
        Where-Object {
            $_.Value -match [regex]::Escape("device                  partition=$efiDevice") -and
            $_.Value -match 'path\s+\\EFI\\BOOT\\BOOTX64\.EFI'
        } |
        Select-Object -First 1
    if (-not $entry) {
        throw "Could not find firmware boot entry for $efiDevice. Refusing to use stale hard-coded GUID."
    }

    $bootId = [regex]::Match($entry.Value, 'identifier\s+(\{[^}]+\})').Groups[1].Value
    if ([string]::IsNullOrWhiteSpace($bootId)) {
        throw "Matched Ventoy firmware entry but could not parse its identifier."
    }

    bcdedit /set '{fwbootmgr}' bootsequence $bootId | Out-Host
    if ($LASTEXITCODE -ne 0) {
        throw "bcdedit failed to set firmware bootsequence to $bootId."
    }
    Write-Host "myfix configured Ventoy default image $ventoyImagePath on $ventoyDrive and firmware bootsequence $bootId ($efiDevice)."
    if (-not $NoReboot) {
        shutdown /r /t 0
    }
}

