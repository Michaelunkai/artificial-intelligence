$script:FullProfileProxy = {
    $calledName = $MyInvocation.MyCommand.Name
    if (-not $calledName -or $calledName -eq '&') {
        $calledName = $MyInvocation.InvocationName
    }
    if (-not $calledName -or $calledName -eq '&') {
        throw 'Full profile proxy could not determine the command name to reload.'
    }
    Load-FullPowerShellProfile
    & (Get-Command $calledName -CommandType Function -ErrorAction Stop) @args
}

foreach ($functionName in $script:FullProfileFunctionNames) {
    if ($functionName -in @('Load-FullPowerShellProfile', 'fullprofile', 'nomouse')) { continue }
    Set-Item -Path "Function:\global:$functionName" -Value $script:FullProfileProxy -Force
}
Set-Item -Path 'Function:\global:myfix' -Value $script:ProfileMyFixOverride -Force
Set-Item -Path 'Function:\global:qaccess' -Value $script:ProfileQAccessOverride -Force
Set-Item -Path 'Function:\global:fixfixfixfix' -Value $script:ProfileFixFixFixFixOverride -Force

function global:remenu {
    Load-FullPowerShellProfile
    $script = 'F:\study\Learning\01\01\Shells\powershell\profile-functions\shells\powershell\menu-tools\Remenu\Invoke-remenu.ps1'
    if (-not (Test-Path -LiteralPath $script -PathType Leaf)) {
        throw "remenu script not found: $script"
    }
    & $script @args
}

function global:backcod {
    $repoRoot = 'F:\study\repos\ai-ml\AI_and_Machine_Learning\Artificial_Intelligence'
    $relativeScript = 'cli/codex/backup/backup-codex.ps1'
    $scriptPath = Join-Path $repoRoot ($relativeScript -replace '/', '\')
    if (-not (Test-Path -LiteralPath $scriptPath -PathType Leaf) -and (Test-Path -LiteralPath (Join-Path $repoRoot '.git'))) {
        $scriptDir = Split-Path -Parent $scriptPath
        if (-not (Test-Path -LiteralPath $scriptDir -PathType Container)) {
            $null = New-Item -ItemType Directory -Path $scriptDir -Force
        }
        & cmd.exe /c "git -C `"$repoRoot`" show HEAD:$relativeScript > `"$scriptPath`"" 2>$null
        if ($LASTEXITCODE -eq 0 -and (Test-Path -LiteralPath $scriptPath -PathType Leaf)) {
            Write-Host "backcod: restored missing script from git: $scriptPath" -ForegroundColor Yellow
        }
    }
    if (-not (Test-Path -LiteralPath $scriptPath -PathType Leaf)) {
        Write-Warning "backcod: script not found and could not be restored: $scriptPath"
        return
    }
    & $scriptPath -Force @args
}

function global:cleanc {
    $script = 'F:\study\Learning\01\01\Shells\powershell\profile-functions\windows\cleanup\system-clean\CleanCSystemCleanup\Invoke-cleanc.ps1'
    if (-not (Test-Path -LiteralPath $script -PathType Leaf)) {
        throw "cleanc script not found: $script"
    }
    . $script @args
}

function global:bacter {
    $settingsPath = "C:\Users\micha\AppData\Local\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json"
    $backupPath = "F:\backup\windowsapps\profile\settings.json"
    $backupDir = Split-Path -Parent $backupPath
    if (-not (Test-Path -LiteralPath $backupDir -PathType Container)) {
        New-Item -ItemType Directory -Path $backupDir -Force | Out-Null
    }
    Copy-Item -LiteralPath $settingsPath -Destination $backupPath -Force
}

function global:rester {
    $settingsPath = "C:\Users\micha\AppData\Local\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json"
    $backupPath = "F:\backup\windowsapps\profile\settings.json"
    $backupDir = Split-Path -Parent $backupPath
    $source = $backupPath

    if (-not (Test-Path -LiteralPath $source -PathType Leaf)) {
        $localState = Split-Path -Parent $settingsPath
        $source = Get-ChildItem -LiteralPath $localState -Filter 'settings.json.before-terminal-fast-*.bak' -File -ErrorAction SilentlyContinue |
            Sort-Object LastWriteTime -Descending |
            Select-Object -ExpandProperty FullName -First 1
    }

    if (-not $source -or -not (Test-Path -LiteralPath $source -PathType Leaf)) {
        if (-not (Test-Path -LiteralPath $settingsPath -PathType Leaf)) {
            throw "rester could not find Windows Terminal settings at '$backupPath' or '$settingsPath'."
        }
        $source = $settingsPath
    }

    Copy-Item -LiteralPath $source -Destination $settingsPath -Force
    $settings = Get-Content -LiteralPath $settingsPath -Raw | ConvertFrom-Json
    $settings.defaultProfile = "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}"
    $settings | ConvertTo-Json -Depth 100 | Set-Content -LiteralPath $settingsPath -Encoding UTF8

    if (-not (Test-Path -LiteralPath $backupDir -PathType Container)) {
        New-Item -ItemType Directory -Path $backupDir -Force | Out-Null
    }
    Copy-Item -LiteralPath $settingsPath -Destination $backupPath -Force
    Write-Host "Windows Terminal settings restored. Default profile: Windows PowerShell v5." -ForegroundColor Green
}

function global:upgrader {
    $script = 'F:\study\Learning\01\01\Shells\powershell\profile-functions\dev-toolchain\package-managers\global-upgrader\GlobalToolchainUpgrader\Invoke-upgrader.ps1'
    if (-not (Test-Path -LiteralPath $script -PathType Leaf)) {
        throw "upgrader script not found: $script"
    }
    . $script @args
}

