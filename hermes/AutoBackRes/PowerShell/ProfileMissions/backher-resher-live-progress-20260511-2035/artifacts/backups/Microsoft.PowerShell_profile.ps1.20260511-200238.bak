    Repair-StandardWindowsProcessEnvironment
    $script = 'F:\study\Learning\01\01\Shells\powershell\winget\WingetAutoUptgadeAll\Invoke-WingetAutoUpgradeAll.ps1'
    if (-not (Test-Path -LiteralPath $script -PathType Leaf)) {
        throw "wingup script not found: $script"
    }
    . $script @args
}

function global:Get-ProfileFunctionSourcePaths {
    $paths = @(
        $script:FullProfileLibraryPath,
        'C:\Users\micha\Documents\WindowsPowerShell\Microsoft.PowerShell_profile.full.ps1',
        $PROFILE,
        'C:\Users\micha\Documents\WindowsPowerShell\Microsoft.PowerShell_profile.ps1',
        'C:\Users\micha\Documents\PowerShell\Microsoft.PowerShell_profile.ps1'
    )

    $seen = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)
    foreach ($path in $paths) {
        if ([string]::IsNullOrWhiteSpace($path)) { continue }
        if (-not (Test-Path -LiteralPath $path -PathType Leaf)) { continue }
        $resolved = (Resolve-Path -LiteralPath $path).ProviderPath
        if ($seen.Add($resolved)) { $resolved }
    }
}

function global:Get-ProfileFunctionMap {
    param(
        [string[]]$ProfilePath
    )

    if (-not $ProfilePath -or $ProfilePath.Count -eq 0) {
        $ProfilePath = @(Get-ProfileFunctionSourcePaths)
    }

    $functionMap = New-Object 'System.Collections.Hashtable' ([System.StringComparer]::OrdinalIgnoreCase)
    foreach ($path in $ProfilePath) {
        if ([string]::IsNullOrWhiteSpace($path) -or -not (Test-Path -LiteralPath $path -PathType Leaf)) { continue }

        $parseErrors = $null
        $tokens = $null
        $ast = [System.Management.Automation.Language.Parser]::ParseFile($path, [ref]$tokens, [ref]$parseErrors)
        if ($parseErrors -and $parseErrors.Count -gt 0) {
            throw "Cannot parse profile function source '$path': $($parseErrors[0].Message)"
        }

        $ast.FindAll({ param($node) $node -is [System.Management.Automation.Language.FunctionDefinitionAst] }, $true) | ForEach-Object {
            $lookupName = $_.Name -replace '^(?i:global:)', ''
            $functionMap[$lookupName] = $_
        }
    }

    $functionMap
}

function global:Get-ProfileFunctionDependencyNames {
    param(
        [Parameter(Mandatory = $true)]
        [System.Management.Automation.Language.FunctionDefinitionAst]$FunctionAst,

        [Parameter(Mandatory = $true)]
        [hashtable]$FunctionMap
    )

    $seen = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)
    $FunctionAst.FindAll({ param($node) $node -is [System.Management.Automation.Language.CommandAst] }, $true) | ForEach-Object {
        $commandName = $_.GetCommandName()
        if ([string]::IsNullOrWhiteSpace($commandName)) { return }
        $lookupName = $commandName -replace '^(?i:global:)', ''
        if ($FunctionMap.ContainsKey($lookupName) -and $seen.Add($lookupName)) {
            $lookupName
        }
    }
}

function global:cfun {
    param(
        [Parameter(Mandatory = $true, Position = 0)]
        [string]$FunctionName
    )

    $functionMap = Get-ProfileFunctionMap
    $lookupName = $FunctionName -replace '^(?i:global:)', ''
    if (-not $functionMap.ContainsKey($lookupName)) {
        Write-Warning "Function '$FunctionName' not found in profile sources: $((Get-ProfileFunctionSourcePaths) -join '; ')"
        return
    }

    $functionMap[$lookupName].Extent.Text.TrimEnd()
}

function global:ccfun {
    param(
        [Parameter(Mandatory = $true, Position = 0)]
        [string]$FunctionName
    )

    $functionMap = Get-ProfileFunctionMap
    $lookupName = $FunctionName -replace '^(?i:global:)', ''
    if (-not $functionMap.ContainsKey($lookupName)) {
        Write-Warning "Function '$FunctionName' not found in profile sources: $((Get-ProfileFunctionSourcePaths) -join '; ')"
        return
    }

    $ordered = New-Object 'System.Collections.Generic.List[string]'
    $visited = New-Object 'System.Collections.Generic.HashSet[string]' ([System.StringComparer]::OrdinalIgnoreCase)

    function Add-ProfileFunctionDependency {
        param([string]$Name)

        $normalizedName = $Name -replace '^(?i:global:)', ''
        if (-not $functionMap.ContainsKey($normalizedName)) { return }
        if (-not $visited.Add($normalizedName)) { return }

        foreach ($dependencyName in Get-ProfileFunctionDependencyNames -FunctionAst $functionMap[$normalizedName] -FunctionMap $functionMap) {
            Add-ProfileFunctionDependency -Name $dependencyName
        }

        $ordered.Add($normalizedName) | Out-Null
    }

    foreach ($dependencyName in Get-ProfileFunctionDependencyNames -FunctionAst $functionMap[$lookupName] -FunctionMap $functionMap) {
        Add-ProfileFunctionDependency -Name $dependencyName
    }

    foreach ($name in $ordered) {
        $functionMap[$name].Extent.Text.TrimEnd()
        ''
    }
}

