function Load-FullPowerShellProfile {
    if ($script:FullProfileLoaded) { return }
    if (-not (Test-Path -LiteralPath $script:FullProfileLibraryPath -PathType Leaf)) {
        throw "Full PowerShell profile library not found: $script:FullProfileLibraryPath"
    }

    Update-FullProfileDefinitionCache -SourcePath $script:FullProfileLibraryPath -CachePath $script:FullProfileDefinitionCachePath
    if (-not (Test-Path -LiteralPath $script:FullProfileDefinitionCachePath -PathType Leaf)) {
        throw "Full PowerShell profile definition cache not found: $script:FullProfileDefinitionCachePath"
    }

    $script:FullProfileLoaded = $true
    $env:PROFILE_FAST_PROXY_LOAD = '1'
    try {
        . $script:FullProfileDefinitionCachePath
        Set-Item -Path 'Function:\global:myfix' -Value $script:ProfileMyFixOverride -Force
        Set-Item -Path 'Function:\global:qaccess' -Value $script:ProfileQAccessOverride -Force
        Set-Item -Path 'Function:\global:fixfixfixfix' -Value $script:ProfileFixFixFixFixOverride -Force
    } finally {
        Remove-Item Env:PROFILE_FAST_PROXY_LOAD -ErrorAction SilentlyContinue
    }
}

