]
required_unresolved = [
    name for name in required
    if name not in quick and resolve_command(name) is None
]
required_menu_missing = [
    name for name in required
    if _sanitize_telegram_name(name) not in menu_names
]

if quick_menu_missing:
    print("READY_FAIL=quick_commands_missing_from_native_menu:" + ",".join(quick_menu_missing[:20]))
