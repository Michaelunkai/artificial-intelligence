        private void SetReadyAfterAction(bool actionSucceeded, string failureStatus)
        {
            if (!actionSucceeded)
            {
                SetStatus(failureStatus);
                return;
            }

            if (IsManualStopRequested())
            {
                SetStatus("manual stop");
                return;
            }

            var health = WaitForGatewayReady(GatewayReadyWaitMs, GatewayReadyPollMs);
            if (health.Healthy)
            {
                SetStatus(health.Working ? "working" : "healthy");
            }
            else if (IsGatewayProcessRunning())
            {
                Log("Post-action readiness not fully green yet; exact gateway process exists, keeping tray green/working instead of sticky not-ready. " + FirstReadyFailure(health.Output));
                SetStatus("working");
            }
            else
            {
                SetStatus(failureStatus);
            }
        }

        private GatewayHealthResult WaitForGatewayReady(int timeoutMs, int pollMs)
        {
            DateTime deadline = DateTime.UtcNow.AddMilliseconds(timeoutMs);
            GatewayHealthResult last = null;
            do
            {
                last = CheckGatewayHealth();
                if (last.Healthy)
                {
                    return last;
                }
                Log("Waiting for ready; keeping current tray color instead of setting sticky yellow waiting state.");
                Thread.Sleep(pollMs);
            }
            while (DateTime.UtcNow < deadline);

            return last ?? new GatewayHealthResult
            {
                ExitCode = 1,
                Output = "No health result returned before timeout.",
                Healthy = false,
                Working = false
            };
        }

        private bool IsManualStopRequested()
        {
