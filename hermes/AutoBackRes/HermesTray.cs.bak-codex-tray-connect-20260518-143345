        private void RunRestartWsl()
        {
            if (!TryEnterWork())
            {
                return;
            }

            ThreadPool.QueueUserWorkItem(delegate
            {
                try
                {
                    SetStatus("wsl restarting");
                    string resumeCommand = "/usr/local/sbin/hermes-create-manual-gateway-intent restart-wsl; env HERMES_ALLOW_GATEWAY_STOP=manual-intent HERMES_TRAY_SEND_READY_PROBE_ALL=1 bash " + Quote(ResumeWslPath);
                    var shutdown = RunHidden("wsl.exe", "--shutdown", 60000);
                    Log("Restart WSL shutdown exit=" + shutdown.ExitCode + Environment.NewLine + shutdown.Output);

                    CommandResult result = new CommandResult(1, "resume was not attempted");
                    DateTime deadline = DateTime.UtcNow.AddMilliseconds(GatewayReadyWaitMs);
                    do
                    {
                        Thread.Sleep(GatewayReadyPollMs);
                        result = RunHidden("wsl.exe", "-d " + Distro + " -u root -- bash -lc " + Quote(resumeCommand), 180000);
                        if (result.ExitCode == 0)
                        {
                            break;
                        }
                        Log("Restart WSL resume attempt exit=" + result.ExitCode + Environment.NewLine + result.Output);
                    }
                    while (DateTime.UtcNow < deadline);

                    Log("Restart WSL recovery exit=" + result.ExitCode + Environment.NewLine + result.Output);
                    SetReadyAfterAction(result.ExitCode == 0, "wsl restart failed");
                }
                finally
                {
                    LeaveWork();
                }
            });
        }

