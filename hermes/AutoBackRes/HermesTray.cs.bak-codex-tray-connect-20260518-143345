        private GatewayHealthResult CheckGatewayHealth()
        {
            var result = RunHidden("wsl.exe", "-d " + Distro + " -u root -- bash " + Quote(HealthWslPath), 60000);
            Log("Status exit=" + result.ExitCode + Environment.NewLine + result.Output);
            bool readyOk = result.Output.IndexOf("READY_OK=1", StringComparison.Ordinal) >= 0;
            bool noReadyFail = result.Output.IndexOf("READY_FAIL=", StringComparison.Ordinal) < 0;
            bool isolated = result.Output.IndexOf("READY_FLEET_ISOLATION_OK=1", StringComparison.Ordinal) >= 0;
            bool enoughHomes = CountMarker(result.Output, "READY_HOME_OK=") >= MinimumTelegramHomes;
            return new GatewayHealthResult
            {
                ExitCode = result.ExitCode,
                Output = result.Output,
                Working = result.Output.IndexOf("READY_WORKING=", StringComparison.Ordinal) >= 0,
                Healthy = result.ExitCode == 0 && readyOk && noReadyFail && isolated && enoughHomes
            };
        }

        private static int CountMarker(string text, string marker)
        {
            if (string.IsNullOrEmpty(text) || string.IsNullOrEmpty(marker))
            {
                return 0;
            }
            int count = 0;
            int index = 0;
            while ((index = text.IndexOf(marker, index, StringComparison.Ordinal)) >= 0)
            {
                count++;
                index += marker.Length;
            }
            return count;
        }

