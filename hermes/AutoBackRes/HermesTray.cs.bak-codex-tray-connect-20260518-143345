            tray.Visible = startGateway;
            tray.ContextMenuStrip = BuildMenu();
            tray.DoubleClick += delegate { RunReconnect("manual double-click"); };

            watchdog = new System.Windows.Forms.Timer();
            // Fast post-WSL recovery: check every second so the icon can go
            // green within 5 seconds after WSL is available again.
            watchdog.Interval = 1000;
            watchdog.Tick += delegate { WatchdogTick(); };

            Log("Hermes tray started");
            if (startGateway)
            {
                watchdog.Start();
                // Do not unconditionally reconnect on tray startup: that can
                // interrupt live Telegram work. Run the normal watchdog path,
                // which health-checks first and only self-heals if a bot is
                // actually missing/unhealthy.
                WatchdogTick();
            }
