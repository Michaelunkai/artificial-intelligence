    internal static class Program
    {
        [STAThread]
        private static void Main(string[] args)
        {
            if (args != null && args.Length > 0 && string.Equals(args[0], "--dashboard", StringComparison.OrdinalIgnoreCase))
            {
                Dashboard.Open("manual dashboard launch");
                return;
            }
            if (args != null && args.Length > 0 && string.Equals(args[0], "--mission-control-smoke", StringComparison.OrdinalIgnoreCase))
            {
                Application.EnableVisualStyles();
                Application.SetCompatibleTextRenderingDefault(false);
                var context = new TrayContext(false);
                try
                {
                    File.WriteAllText(Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "mission-control-smoke.txt"), "MISSION_CONTROL_BUTTONS=" + context.MissionControlButtonCountForTest() + Environment.NewLine, Encoding.UTF8);
                    return;
                }
                finally
                {
                    context.DisposeForSmokeTest();
                }
            }
            if (args != null && args.Length > 0 && string.Equals(args[0], "--menu-smoke", StringComparison.OrdinalIgnoreCase))
            {
                Application.EnableVisualStyles();
                Application.SetCompatibleTextRenderingDefault(false);
                var context = new TrayContext(false);
                try
                {
                    File.WriteAllText(Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "menu-smoke.txt"), context.MenuSmokeReportForTest(), Encoding.UTF8);
                    return;
                }
                finally
                {
                    context.DisposeForSmokeTest();
                }
            }

            bool created;
            using (var mutex = new Mutex(true, "Global\\HermesWsl2TrayAutoBackRes", out created))
            {
                if (!created)
                {
                    return;
                }

                Application.EnableVisualStyles();
                Application.SetCompatibleTextRenderingDefault(false);
                Application.Run(new TrayContext());
            }
        }
    }

