        private void PauseGateway()
        {
            if (!TryEnterWork())
            {
                return;
            }

            ThreadPool.QueueUserWorkItem(delegate
            {
                try
                {
                    SetManualStop();
                    SetStatus("pausing gateway");
                    string command = "/usr/local/sbin/hermes-create-manual-gateway-intent manual-stop; HOME_DIR=/home/ubuntu; for h in \"$HOME_DIR/.hermes\" \"$HOME_DIR\"/.hermes-*; do [ -d \"$h\" ] || continue; [ -f \"$h/config.yaml\" ] || continue; [ -f \"$h/.env\" ] || continue; grep -q '^TELEGRAM_BOT_TOKEN=' \"$h/.env\" || continue; b=$(basename \"$h\"); if [ \"$b\" = .hermes ]; then s=hermes-gateway; else s=hermes-${b#.hermes-}; fi; sudo -H -u ubuntu env HERMES_ALLOW_GATEWAY_STOP=manual-intent tmux kill-session -t \"=$s\" 2>/dev/null || true; done; exit 0";
                    var result = RunHidden("wsl.exe", "-d " + Distro + " -u root -- bash -lc " + Quote(command), 60000);
                    SetStatus(result.ExitCode == 0 ? "manual stop" : "pause failed");
                    Log("Pause gateway exit=" + result.ExitCode + Environment.NewLine + result.Output);
                }
                finally
                {
                    LeaveWork();
                }
            });
        }

