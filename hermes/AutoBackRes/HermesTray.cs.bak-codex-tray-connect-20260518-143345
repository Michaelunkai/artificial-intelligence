        private void WatchdogTick()
        {
            if (busy)
            {
                return;
            }

            ThreadPool.QueueUserWorkItem(delegate
            {
                if (IsManualStopRequested())
                {
                    SetStatus("manual stop");
                    return;
                }

                var health = CheckGatewayHealth();
                if (health.Healthy)
                {
                    SetStatus(health.Working ? "working" : "healthy");
                    return;
                }

                if (!IsGatewayProcessRunning())
                {
                    Log("Watchdog detected no Hermes gateway process; starting post-WSL boot recovery.");
                    RunReconnect("watchdog post-wsl recovery");
                    return;
                }

                if (IsRecoverableHealthFailure(health))
                {
                    string reason = FirstReadyFailure(health.Output);
                    var elapsedMs = (DateTime.UtcNow - lastSelfHealAttemptUtc).TotalMilliseconds;
                    // Do not paint the tray yellow for recoverable watchdog work.
                    // The health/resume scripts distinguish real failures; during safe
                    // self-heal we keep the icon green/working so transient checks do
                    // not get stuck visually as "recovering".
                    SetStatus("working");
                    if (elapsedMs >= WatchdogSelfHealCooldownMs)
                    {
                        lastSelfHealAttemptUtc = DateTime.UtcNow;
                        Log("Watchdog detected recoverable unhealthy fleet (" + reason + "); running safe resume.");
                        RunReconnect("watchdog recoverable health: " + reason);
                        return;
                    }

                    Log("Watchdog detected recoverable unhealthy fleet (" + reason + ") inside cooldown; waiting before retry.");
                    return;
                }

                SetStatus("not healthy");
                Log("Watchdog detected unrecoverable unhealthy fleet with a gateway process still running; not reconnecting automatically. " + FirstReadyFailure(health.Output));
            });
        }

        private bool IsRecoverableHealthFailure(GatewayHealthResult health)
        {
            if (health == null)
            {
                return true;
            }

            string output = health.Output ?? string.Empty;
            string[] recoverableMarkers = new string[]
            {
                "READY_FAIL=duplicate_or_missing_gateway_processes",
                "READY_FAIL=config_changed_requires_gateway_reload",
                "READY_FAIL=runtime_state_metadata_mismatch",
                "READY_FAIL=runtime_state_no_pid",
                "READY_FAIL=telegram_polling_not_running",
                "READY_FAIL=telegram_polling_heartbeat_missing",
                "READY_FAIL=telegram_polling_heartbeat_bad_timestamp",
                "READY_FAIL=telegram_polling_heartbeat_stale",
                "READY_FAIL=telegram_unanswered_work_stale",
                "READY_FAIL=recent_gateway_error",
                "READY_FAIL=telegram_sessions_blocked",
                "READY_FAIL=telegram_pending_updates_backlog",
                "READY_FAIL=telegram_menu_sync_failed",
                "READY_FAIL=fleet_not_ready",
                "READY_FAIL_HOME="
            };

            foreach (string marker in recoverableMarkers)
            {
                if (output.IndexOf(marker, StringComparison.Ordinal) >= 0)
                {
                    return true;
                }
            }

            return false;
        }

        private string FirstReadyFailure(string output)
        {
            if (string.IsNullOrEmpty(output))
            {
                return "no health output";
            }

            string[] lines = output.Replace("\r\n", "\n").Split('\n');
            foreach (string rawLine in lines)
            {
                string line = rawLine.Trim();
                if (line.StartsWith("READY_FAIL=", StringComparison.Ordinal) || line.StartsWith("READY_FAIL_HOME=", StringComparison.Ordinal))
                {
                    return line.Length > 180 ? line.Substring(0, 180) : line;
                }
            }

            return "exit=" + (output.Length > 180 ? output.Substring(0, 180) : output);
        }

        private bool TryEnterWork()
        {
            lock (gate)
            {
                if (busy)
                {
                    return false;
                }
                busy = true;
                return true;
            }
        }

        private void LeaveWork()
        {
            lock (gate)
            {
                busy = false;
            }
        }

        private void RunReconnect(string reason)
        {
            if (!TryEnterWork())
            {
                return;
            }

            ThreadPool.QueueUserWorkItem(delegate
            {
                try
                {
                    ClearManualStop();
                    SetStatus("reconnecting");
                    string command = "env HERMES_TRAY_FAST_BOOT=1 HERMES_TRAY_GATEWAY_READY_TIMEOUT_SECONDS=4 HERMES_TRAY_GATEWAY_READY_POLL_SECONDS=0.2 bash " + Quote(ResumeWslPath);
                    var result = RunHidden("wsl.exe", "-d " + Distro + " -u root -- bash -lc " + Quote(command), 180000);
                    Log("Reconnect (" + reason + ") exit=" + result.ExitCode + Environment.NewLine + result.Output);
                    if (result.ExitCode == 75 && result.Output.IndexOf("already running", StringComparison.OrdinalIgnoreCase) >= 0)
                    {
                        Log("Reconnect (" + reason + ") found an existing resume in progress; waiting for final green readiness instead of leaving the icon yellow.");
                        SetReadyAfterAction(true, "resume wait failed");
                        return;
                    }
                    SetReadyAfterAction(result.ExitCode == 0, "resume failed");
                }
                finally
                {
                    LeaveWork();
                }
            });
        }

