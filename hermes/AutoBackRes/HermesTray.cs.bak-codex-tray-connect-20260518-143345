            html.AppendLine("<article class=\"card full\"><div class=\"label\">Dashboard design notes</div><p class=\"note\">Built as an operational dashboard: immediate health at the top, then narrow-down panels for process, backup, and logs. This follows current dashboard/status-page guidance: show the most important status first, keep operational details scannable, and make investigation paths obvious.</p></article>");
            html.AppendLine("</section></main></body></html>");

            File.WriteAllText(DashboardPath, html.ToString(), Encoding.UTF8);
            Process.Start(new ProcessStartInfo { FileName = DashboardPath, UseShellExecute = true, WindowStyle = ProcessWindowStyle.Hidden });
        }

        private static void AddCard(StringBuilder html, string title, string metric, string note, string[] pills)
        {
            html.AppendLine("<article class=\"card\"><div class=\"label\">" + Html(title) + "</div><div class=\"metric\">" + Html(metric) + "</div><p class=\"note\">" + Html(note) + "</p><div class=\"rail\">");
            for (int i = 0; i < pills.Length; i++)
            {
                html.AppendLine("<span class=\"pill\">" + Html(pills[i]) + "</span>");
            }
            html.AppendLine("</div></article>");
        }

        private static void AddPre(StringBuilder html, string title, string value, string cls)
        {
            html.AppendLine("<article class=\"" + cls + "\"><div class=\"label\">" + Html(title) + "</div><div class=\"mono\">" + Html(value) + "</div></article>");
        }

        private static string LatestBackupSummary()
        {
            string backupRoot = Path.Combine(Root, "backups");
            if (!Directory.Exists(backupRoot))
            {
                return "No backup folder";
            }
            var dirs = Directory.GetDirectories(backupRoot);
            Array.Sort(dirs, StringComparer.OrdinalIgnoreCase);
            if (dirs.Length == 0)
            {
                return "No backups yet";
            }
            string latest = dirs[dirs.Length - 1];
            string archive = Path.Combine(latest, "hermes-wsl-data.tar.gz");
            long mb = File.Exists(archive) ? new FileInfo(archive).Length / 1024 / 1024 : 0;
            return Path.GetFileName(latest) + (mb > 0 ? " / " + mb + " MB" : "");
        }

        private static string TailFile(string path, int count)
        {
            if (!File.Exists(path))
            {
                return "Missing: " + path;
            }
            string[] lines = File.ReadAllLines(path, Encoding.UTF8);
            int start = Math.Max(0, lines.Length - count);
            var sb = new StringBuilder();
            for (int i = start; i < lines.Length; i++)
            {
                sb.AppendLine(lines[i]);
            }
            return sb.ToString();
        }

        private static CommandResult RunHidden(string fileName, string arguments, int timeoutMs)
        {
            var output = new StringBuilder();
            try
            {
                var psi = new ProcessStartInfo();
                psi.FileName = fileName;
                psi.Arguments = arguments;
                psi.UseShellExecute = false;
                psi.CreateNoWindow = true;
                psi.WindowStyle = ProcessWindowStyle.Hidden;
                psi.RedirectStandardOutput = true;
                psi.RedirectStandardError = true;
                using (var process = new Process())
                {
                    process.StartInfo = psi;
                    process.OutputDataReceived += delegate(object sender, DataReceivedEventArgs e) { if (e.Data != null) output.AppendLine(e.Data); };
                    process.ErrorDataReceived += delegate(object sender, DataReceivedEventArgs e) { if (e.Data != null) output.AppendLine(e.Data); };
                    process.Start();
                    process.BeginOutputReadLine();
                    process.BeginErrorReadLine();
                    if (!process.WaitForExit(timeoutMs))
                    {
                        try { process.Kill(); } catch { }
                        output.AppendLine("Timed out after " + timeoutMs + "ms");
                        return new CommandResult(124, output.ToString());
                    }
                    return new CommandResult(process.ExitCode, output.ToString());
                }
            }
            catch (Exception ex)
            {
                output.AppendLine(ex.ToString());
                return new CommandResult(1, output.ToString());
            }
        }

        private static string Html(string value)
        {
            if (value == null) { return ""; }
            return value.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;").Replace("\"", "&quot;");
        }

        private static string Quote(string value)
        {
            if (value == null) { return "\"\""; }
            return "\"" + value.Replace("\\", "\\\\").Replace("\"", "\\\"") + "\"";
        }

        private static string ToWslPath(string windowsPath)
        {
            string fullPath = Path.GetFullPath(windowsPath);
            string root = Path.GetPathRoot(fullPath);
            char drive = char.ToLowerInvariant(root[0]);
            string relative = fullPath.Substring(root.Length).Replace('\\', '/');
            return "/mnt/" + drive + "/" + relative;
        }

        private sealed class CommandResult
        {
            public readonly int ExitCode;
            public readonly string Output;

            public CommandResult(int exitCode, string output)
            {
                ExitCode = exitCode;
                Output = output;
            }
        }
    }
