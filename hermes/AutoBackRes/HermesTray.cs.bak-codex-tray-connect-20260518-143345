        private Color StatusTextColor(string iconColor)
        {
            switch ((iconColor ?? string.Empty).ToLowerInvariant())
            {
                case "green": return Color.FromArgb(41, 242, 143);
                case "yellow": return Color.FromArgb(255, 211, 90);
                case "red": return Color.FromArgb(255, 91, 110);
                case "purple": return Color.FromArgb(183, 136, 255);
                default: return Color.FromArgb(237, 253, 244);
            }
        }

        private Icon StatusIconFor(string status)
        {
            string s = (status ?? string.Empty).ToLowerInvariant();
            if (s.Contains("paused") || s.Contains("stopped") || s.Contains("manual stop"))
            {
                return purpleIcon;
            }
            if (s.Contains("failed") || s.Contains("error") || s.Contains("broken") || s.Contains("not healthy") || s.Contains("not ready"))
            {
                return redIcon;
            }
            if (s == "healthy" || s == "working")
            {
                return greenIcon;
            }
            return yellowIcon;
        }

        private string StatusIconColorName(string status)
        {
            string s = (status ?? string.Empty).ToLowerInvariant();
            if (s.Contains("paused") || s.Contains("stopped") || s.Contains("manual stop"))
            {
                return "purple";
            }
            if (s.Contains("failed") || s.Contains("error") || s.Contains("broken") || s.Contains("not healthy") || s.Contains("not ready"))
            {
                return "red";
            }
            if (s == "healthy" || s == "working")
            {
                return "green";
            }
            return "yellow";
        }

        private static Icon CreateStatusIcon(Color color)
        {
            using (var bitmap = new Bitmap(16, 16))
            {
                using (var g = Graphics.FromImage(bitmap))
                {
                    g.Clear(Color.Transparent);
                    using (var border = new SolidBrush(Color.FromArgb(45, 45, 45)))
                    using (var fill = new SolidBrush(color))
                    using (var shine = new SolidBrush(Color.FromArgb(120, Color.White)))
                    {
                        g.FillEllipse(border, 1, 1, 14, 14);
                        g.FillEllipse(fill, 3, 3, 10, 10);
                        g.FillEllipse(shine, 5, 4, 3, 3);
                    }
                }
                return (Icon)Icon.FromHandle(bitmap.GetHicon()).Clone();
            }
        }

